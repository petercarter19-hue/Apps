<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PhotoTwins</RootNamespace>
    <AssemblyName>PhotoTwins</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <ApplicationIcon>photostwins.ico</ApplicationIcon>
    <Product>PhotoTwins</Product>
    <Description>Finds duplicate photos and helps clear out the extra copies safely</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="photostwins-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoTwins.Core\PhotoTwins.Core.csproj" />
  </ItemGroup>

</Project>
