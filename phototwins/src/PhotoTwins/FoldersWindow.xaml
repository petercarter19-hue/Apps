<Window x:Class="PhotoTwins.FoldersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="780" Height="880" MinWidth="580" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize">
    <Grid Margin="20" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ScanHeading" Grid.Row="0" Text="Folders to scan" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="PhotoTwins looks for duplicates only in these folders, and in the folders inside them. It never looks in other people's Windows accounts."/>
            <ListBox x:Name="FolderListBox" Grid.Row="1" MinHeight="90" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding Path}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Problem}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding SharedReason}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SharedReason}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="AddButton" Content="Add a folder…" Padding="14,7" Margin="0,0,8,0" Click="OnAdd"/>
                <Button x:Name="RemoveButton" Content="Remove" Padding="14,7" Click="OnRemove"/>
            </StackPanel>
        </Grid>

        <TextBlock x:Name="SharedHeading" Grid.Row="2" Text="Folders you share with other people" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,4"/>
        <TextBlock x:Name="SharedIntro" Grid.Row="3" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="PhotoTwins finds shared folders by itself where Windows knows about them (OneDrive sharing, network shares, the Public folder). If you share a folder in a way Windows can't tell it about, add it here. A copy in a shared folder is always the one kept, and removing from one asks a second time."/>
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ListBox x:Name="SharedListBox" Grid.Row="0" MinHeight="70" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,4"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="AddSharedButton" Content="Mark a folder as shared…" Padding="14,7" Margin="0,0,8,0" Click="OnAddShared"/>
                <Button x:Name="RemoveSharedButton" Content="Remove" Padding="14,7" Click="OnRemoveShared"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="5" Margin="0,18,0,0">
            <TextBlock x:Name="LookAlikeHeading" Text="Look-alikes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="LookAlikeIntro" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Look-alikes are different photos that look very much alike, such as shots taken seconds apart. They are shown on their own tab, are never counted as duplicates, and are only ever removed one group at a time."/>
            <CheckBox x:Name="LookAlikesCheck" Content="Also look for look-alikes" Checked="OnLookAlikeChanged" Unchecked="OnLookAlikeChanged"/>
            <StackPanel x:Name="StrictnessPanel" Margin="28,6,0,0">
                <RadioButton x:Name="StrictStrict" GroupName="Strictness" Checked="OnLookAlikeChanged" Margin="0,2">
                    <TextBlock TextWrapping="Wrap" Text="Strict: only shots taken within 10 seconds that look almost the same."/>
                </RadioButton>
                <RadioButton x:Name="StrictNormal" GroupName="Strictness" Checked="OnLookAlikeChanged" Margin="0,2">
                    <TextBlock TextWrapping="Wrap" Text="Normal: shots within about a minute that look very similar."/>
                </RadioButton>
                <RadioButton x:Name="StrictLoose" GroupName="Strictness" Checked="OnLookAlikeChanged" Margin="0,2">
                    <TextBlock TextWrapping="Wrap" Text="Loose: anything from the same five minutes that looks somewhat similar. Finds more, including photos that only share a scene."/>
                </RadioButton>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="MessageText" Grid.Row="6" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="DoneButton" Content="Done" Padding="18,7" IsDefault="True" Click="OnDone" Style="{DynamicResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
