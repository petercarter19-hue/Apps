<UserControl x:Class="PhotoTwins.UndoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PhotoTwins"
             Focusable="False"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <DataTemplate x:Key="RowTemplate" DataType="{x:Type local:UndoRowVm}">
            <Grid Margin="0,0,0,10" Opacity="{Binding RowOpacity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="Auto" MinWidth="110"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{Binding NameText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding FolderText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{Binding StatusText}" Visibility="{Binding StatusVisibility}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="{Binding WhereText}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Put back" Command="{Binding PutBackCommand}" Visibility="{Binding ButtonVisibility}"
                        Padding="14,6" VerticalAlignment="Top" HorizontalAlignment="Right"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ActionTemplate" DataType="{x:Type local:UndoActionVm}">
            <ContentControl Style="{DynamicResource GlassCard}" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Header}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Grid.Column="1" Content="Put back all" Command="{Binding PutBackAllCommand}" Visibility="{Binding PutBackAllVisibility}" Padding="14,6"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"/>
                    <TextBlock Text="{Binding MoreText}" Visibility="{Binding MoreVisibility}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </ContentControl>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="IntroText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Every photo PhotoTwins has removed is listed here, newest first. Put back returns a photo to the folder it came from, exactly as it was. Nothing is ever deleted for good."/>
        <ContentControl Grid.Row="1" Style="{DynamicResource GlassCard}" Visibility="{Binding MessageVisibility}" Margin="0,0,0,12" Padding="14,12">
            <TextBlock x:Name="MessageText" Text="{Binding Message}" TextWrapping="Wrap"/>
        </ContentControl>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
            <Grid Margin="2,0,4,0">
                <ItemsControl x:Name="ActionsList" ItemsSource="{Binding Actions}" ItemTemplate="{StaticResource ActionTemplate}" Focusable="False"/>
                <TextBlock x:Name="EmptyText" Text="Nothing has been removed yet." Visibility="{Binding EmptyVisibility}" FontSize="15"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Content="Close" Padding="18,7" IsDefault="True" Click="OnClose" Style="{DynamicResource AccentButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
