<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>spotlight.ico</ApplicationIcon>
    <AssemblyName>Spotlight</AssemblyName>
    <RootNamespace>Spotlight</RootNamespace>
    <Version>1.3.2</Version>
    <Product>Spotlight</Product>
    <Company>Pete Carter</Company>
    <Description>Dims everything on every screen except the window you are in</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- No debug symbols or local folder paths inside the published exe -->
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**;tools\**;installer\**" />
    <None Remove="tests\**;tools\**;installer\**" />
  </ItemGroup>

</Project>
